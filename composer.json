{
    "name": "imran1oss/piprapay-laravel-sdk",
    "description": "A modern Laravel SDK for the self-hosted PipraPay payment API.",
    "keywords": [
        "piprapay",
        "laravel",
        "payment",
        "payment-gateway",
        "sdk"
    ],
    "homepage": "https://github.com/imran1oss/piprapay-laravel-sdk",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "imran1oss",
            "homepage": "https://github.com/imran1oss"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Imran1oss\\PipraPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Imran1oss\\PipraPay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Imran1oss\\PipraPay\\PipraPayServiceProvider"
            ],
            "aliases": {
                "PipraPay": "Imran1oss\\PipraPay\\Facades\\PipraPay"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
